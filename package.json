{
	"name": "retold-content-system",
	"version": "1.0.22",
	"description": "Retold Content System - Markdown content viewer and editor",
	"main": "source/Pict-ContentSystem-Bundle.js",
	"bin": {
		"retold-content-system": "source/cli/ContentSystem-CLI-Run.js",
		"rcs": "source/cli/ContentSystem-CLI-Run.js"
	},
	"files": [
		"source/",
		"build/",
		"web-application/",
		"html/",
		"css/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"start": "node source/cli/ContentSystem-CLI-Run.js serve",
		"build": "npx quack build && npx quack copy",
		"build-codemirror": "node build/build-codemirror-bundle.js",
		"build-codejar": "node build/build-codejar-bundle.js",
		"build-all": "npm run build-codemirror && npm run build-codejar && npm run build",
		"prepack": "npm run build-all",
		"test": "echo \"Error: no test specified\" && exit 0",
		"prepublishOnly": "npm test",
		"postversion": "npx quack release postversion",
		"postpublish": "npx quack release postpublish",
		"publish:docker": "npx quack release publish --image",
		"release:patch": "npx quack release patch",
		"release:minor": "npx quack release minor",
		"release:major": "npx quack release major",
		"release:patch:image": "npx quack release patch --image",
		"release:minor:image": "npx quack release minor --image",
		"release:major:image": "npx quack release major --image"
	},
	"retoldBeacon": {
		"displayName": "Retold Content System",
		"description": "Markdown content viewer + editor server; serves a content folder over HTTP and registers as a beacon.",
		"category": "content",
		"mode": "standalone-service",
		"bin": "source/cli/ContentSystem-CLI-Run.js",
		"argTemplate": [
			"serve",
			{
				"fromLabPath": "ContentPath"
			},
			"-p",
			{
				"fromLabPath": "Port"
			},
			"-b",
			{
				"fromLabPath": "UltravisorURL"
			},
			"--beacon-name",
			{
				"fromLabPath": "BeaconName"
			}
		],
		"healthCheck": {
			"path": "/"
		},
		"defaultPort": 7780,
		"requiresUltravisor": true,
		"configForm": {
			"Fields": [
				{
					"Name": "HostContentPath",
					"Label": "Host markdown folder to serve",
					"Type": "text",
					"Required": true,
					"Help": "Absolute path on the host whose markdown contents will be served; bind-mounted read-only into the container at /app/content."
				}
			]
		},
		"docker": {
			"image": "retold-content-system",
			"dockerfile": "retold-content-system.Dockerfile",
			"dataMountPath": "/app/data",
			"configMountPath": "/app/data/config.json",
			"contentMountPath": "/app/content",
			"exposedPort": 7780,
			"configMounts": [
				{
					"ConfigField": "HostContentPath",
					"Target": "/app/content",
					"ReadOnly": true
				}
			]
		}
	},
	"author": "steven velozo <steven@velozo.com>",
	"license": "MIT",
	"optionalDependencies": {
		"ultravisor-beacon": "^0.0.14"
	},
	"dependencies": {
		"fable": "^3.1.71",
		"orator": "^6.1.1",
		"orator-serviceserver-restify": "^2.0.10",
		"pict": "^1.0.365",
		"pict-application": "^1.0.33",
		"pict-provider": "^1.0.12",
		"pict-provider-vocabulary": "^0.0.6",
		"pict-section-code": "^1.0.4",
		"pict-section-content": "^0.1.5",
		"pict-section-filebrowser": "^0.0.2",
		"pict-section-inlinedocumentation": "^0.0.5",
		"pict-section-markdowneditor": "^1.0.10",
		"pict-section-modal": "^0.0.5",
		"pict-service-commandlineutility": "^1.0.19",
		"pict-view": "^1.0.68"
	},
	"devDependencies": {
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"codejar": "^4.3.0",
		"codemirror": "^6.0.2",
		"esbuild": "^0.28.0",
		"highlight.js": "^11.11.1",
		"pict-docuserve": "^0.1.5",
		"quackage": "^1.2.0"
	},
	"copyFilesSettings": {
		"whenFileExists": "overwrite"
	},
	"copyFiles": [
		{
			"from": "./html/*",
			"to": "./web-application/"
		},
		{
			"from": "./css/**",
			"to": "./web-application/css/"
		},
		{
			"from": "./node_modules/pict/dist/pict.min.js",
			"to": "./web-application/js/"
		},
		{
			"from": "./node_modules/pict/dist/pict.min.js.map",
			"to": "./web-application/js/"
		},
		{
			"from": "./node_modules/highlight.js/styles/github.css",
			"to": "./web-application/css/"
		}
	]
}
